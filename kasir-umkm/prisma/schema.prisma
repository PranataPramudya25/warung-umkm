generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

model product {
  id        Int      @id @default(autoincrement())
  name      String
  price     Int
  category  String   @default("Umum")
  stock     Int      @default(0)
  image     String   @default("")
  createdAt DateTime @default(now()) // Harus ada baris ini!
}